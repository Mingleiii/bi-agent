# ===== 环境与鉴权 =====
BIAGENT_ENV=dev
# API 鉴权密钥；为空表示开发模式不鉴权（生产必须设置）
BIAGENT_API_KEY=
# 每分钟每调用方最大请求数
BIAGENT_RATE_LIMIT_PER_MIN=60

# ===== LLM 后端 =====
# mock: 内置确定性后端（开发/测试，全链路可跑）；openai: OpenAI 兼容接口
BIAGENT_LLM_PROVIDER=mock
BIAGENT_LLM_BASE_URL=https://api.openai.com/v1
BIAGENT_LLM_API_KEY=
BIAGENT_MODEL_SMALL=gpt-4o-mini
BIAGENT_MODEL_LARGE=gpt-4o
BIAGENT_MODEL_MULTIMODAL=gpt-4o
BIAGENT_LLM_TIMEOUT_SECONDS=60
BIAGENT_LLM_MAX_RETRIES=2

# ===== 功能开关（灰度与排障） =====
BIAGENT_CACHE_ON=true
BIAGENT_CACHE_TTL_SECONDS=300
BIAGENT_GUARDRAIL_ON=true
BIAGENT_AUDIT_ON=true
BIAGENT_AUDIT_PATH=logs/audit.jsonl

# ===== 编排 =====
BIAGENT_SESSION_MAX_TURNS=10
BIAGENT_ROUTE_CONFIDENCE_THRESHOLD=0.6
